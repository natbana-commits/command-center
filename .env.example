TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
GOOGLE_CALENDAR_ICS_URL=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_WEBHOOK_SECRET=

# Gmail + Drive + Tasks + Calendar integration — optional, safe to leave
# blank (these features no-op until all three are set). One Google OAuth
# client covering gmail.readonly, drive.readonly, tasks, and
# calendar.events scopes. See docs/google-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Lecture transcription (Whisper) — optional, safe to leave blank (uploads
# just fail gracefully with an error until this is set). Needs a payment
# method on file at platform.openai.com.
OPENAI_API_KEY=

# Shared secret for the reminder-check endpoint, called every few minutes
# by a GitHub Actions workflow (.github/workflows/reminder-check.yml) to
# actually fire timed reminder texts. Same idea as CRON_SECRET above, just
# for a separate poller since Vercel's own free cron only runs daily.
REMINDER_CHECK_SECRET=
