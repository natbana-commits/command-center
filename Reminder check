name: Reminder check

on:
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch: {}

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger reminder check
        run: |
          curl -sf -X POST "https://command-center-navy-pi.vercel.app/api/reminder-check" \
            -H "Authorization: Bearer ${{ secrets.REMINDER_CHECK_SECRET }}"
