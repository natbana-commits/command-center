{
  "functions": {
    "api/donna-upload.ts": { "maxDuration": 60 },
    "api/telegram-webhook.ts": { "maxDuration": 30 },
    "api/morning-brief.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.plaid.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.plaid.com https://afggmfupeiahjnanreoy.supabase.co; frame-src https://cdn.plaid.com https://*.plaid.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/donna", "destination": "/api/donna" },
    { "source": "/donna/login", "destination": "/api/donna?page=login" },
    { "source": "/donna/logout", "destination": "/api/donna?page=logout" },
    { "source": "/donna/files", "destination": "/api/donna-calendar?page=files" },
    { "source": "/donna/calendar", "destination": "/api/donna-calendar" },
    { "source": "/donna/reminders", "destination": "/api/donna-reminders" },
    { "source": "/donna/contacts", "destination": "/api/donna-reminders?page=contacts" },
    { "source": "/donna/settings", "destination": "/api/donna-settings" },
    { "source": "/donna/ipos", "destination": "/api/donna-finances?page=ipos" },
    { "source": "/donna/finances", "destination": "/api/donna-finances" },
    { "source": "/donna/school", "destination": "/api/donna-calendar?page=school" },
    { "source": "/donna/chat", "destination": "/api/donna-chat?page=chat" },
    { "source": "/api/plaid-webhook", "destination": "/api/donna-finances" },
    { "source": "/api/reminder-check", "destination": "/api/morning-brief" },
    { "source": "/", "destination": "/api/donna" }
  ]
}
